# Copy to .env for local docker-compose development.
# In Kubernetes these values come from Vault via External Secrets Operator.

# --- Slack ---
# api.slack.com/apps -> Basic Information -> Signing Secret
SLACK_SIGNING_SECRET=
# api.slack.com/apps -> OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Optional: only needed if you enable Socket Mode for local dev (xapp-...)
SLACK_APP_TOKEN=

# --- Postgres ---
POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom
POSTGRES_DB=mushroom
# Used by services; host is the compose service name
DATABASE_URL=postgresql://mushroom:mushroom@postgres:5432/mushroom

# --- Model provider ---
# Which model the agents run, as `provider/model`. The prefix selects the
# backend, so switching providers is a config change:
#   openrouter/deepseek/deepseek-v4-flash-0731   one key, many vendors
#   anthropic/claude-sonnet-4.5              direct
#   openai/gpt-5                             direct
OPENCODE_MODEL=openrouter/deepseek/deepseek-v4-flash-0731
# The credential, and the variable name opencode expects it under. The name is
# provider-specific and must match OPENCODE_MODEL's prefix.
MODEL_API_KEY=
MODEL_API_KEY_ENV=OPENROUTER_API_KEY
