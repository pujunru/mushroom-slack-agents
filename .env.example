# Copy to .env for local docker-compose development.
# In Kubernetes these values come from Vault via External Secrets Operator.

# --- Slack ---
# From api.slack.com/apps -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=
# Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=
# Optional: only needed if you enable Socket Mode for local dev (xapp-...)
SLACK_APP_TOKEN=

# --- Postgres ---
POSTGRES_USER=mushroom
POSTGRES_PASSWORD=mushroom
POSTGRES_DB=mushroom
# Used by services; host is the compose service name
DATABASE_URL=postgresql://mushroom:mushroom@postgres:5432/mushroom

# --- Agent / opencode ---
ANTHROPIC_API_KEY=
